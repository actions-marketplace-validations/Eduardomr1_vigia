{
  "name": "vigia",
  "version": "1.6.0",
  "description": "Flags tests that pass without verifying anything, and comments the finding on each Pull Request.",
  "license": "MIT",
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "vigia": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
